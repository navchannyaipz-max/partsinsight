digraph G { rankdir=TB; compound=true; ranksep=0.35; nodesep=0.5;
 GRAPH_HEAD
 init [shape=circle, label="", width=0.25, style=filled, fillcolor=black];
 fin [shape=doublecircle, label="", width=0.25, style=filled, fillcolor=black];
 subgraph cluster_h { label="Дослідник"; labeljust=l; style=solid;
  a [shape=box, style="rounded,filled", label="Перевірка та затвердження\n20 запитів (queries.csv)"];
  e [shape=box, style="rounded,filled", label="Експертна розмітка\n(expert_sheet.csv)"]; }
 subgraph cluster_s { label="Система (e1.command / run_all.py)"; labeljust=l; style=solid;
  b [shape=box, style="rounded,filled", label="freeze: фіксація запитів, джерел,\nаналогів, курсів, хешів"];
  c [shape=box, style="rounded,filled", label="collect: збір відповідей\n(повтор лише пропущеного)"];
  d [shape=box, style="rounded,filled", label="evaluate: ранжування\nдвох методів"];
  f [shape=box, style="rounded,filled", label="labels: перенесення міток"];
  g [shape=box, style="rounded,filled", label="metrics: Hit@1, Precision@5;\nзвіт e1_report.md"]; }
 init->a->b->c->d->e->f->g->fin;
}
